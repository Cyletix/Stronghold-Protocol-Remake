        },
        "runtimeField": "MathUtil.FP_LARGE_EPS (static offset 0)",
        "unreadableInitializer": "work/client-logic/native-enemy-hp/183473__cctor.asm",
        "suggestedSharedApproximation": 1e-05,
        "notEstablished": "FP_LARGE_EPS initialization from LARGE_EPS and exact FP rounding are not decoded."
      }
    }
  },
  "lifecycleContract": {
    "status": "Verified checker methods; provider attach/detach lifecycle Inferred separately",
    "initial": {
      "source": "work/client-logic/native-enemy-mode-dispatch/HpRatioToggleChecker.CheckInitialToggled.asm",
      "rule": "_setInitialToggle ? _initialToggle : _CheckCondition()",
      "boundary": "Initial provider getter/setter ordering remains governed by the provider contract."
    },
    "OnAttached": {
      "rule": "No HpRatioToggleChecker override in metadata. Base Checker.OnAttached has a no-op non-hotfix baseline.",
      "source": "work/client-logic/native-enemy-hp/76372_OnAttached.asm"
    },
    "OnTick": {
      "source": "work/client-logic/native-enemy-mode-dispatch/HpRatioToggleChecker.OnTick.asm",
      "repeat": "if !_toggleOnce: checker.toggled = _CheckCondition()",
      "once": [
        "if m_hasToggleChanged return",
        "evaluate current checker.toggled and _CheckCondition()",
        "if they differ: set m_hasToggleChanged=true, then assign checker.toggled=!checker.toggled"
      ],
      "boundary": "One-shot freezes after the first difference, either direction. The latch is set before the setter call; it is not proof that a Buff successfully changed. Do not replace this with always staying true after crossing HP."
    },
    "reset": {
      "known": "LoadData sets m_hasToggleChanged=false",
      "unknown": "Detach/reattach resets and preserved checker state are not established. Inverse provider semantics must retain getter/setter behavior."
    }
  },
