    "ratio": "owner.get_hpRatio(); serialized float bounds converted to FP",
    "useLTForMax": {
      "true": "MathUtil.GE(hp, min) && MathUtil.LT(hp, max)",
      "false": "MathUtil.Between(hp, min, max)"
    },
    "comparisonContract": {
      "GE": "a > b - FP_LARGE_EPS",
      "LT": "a < b - FP_LARGE_EPS",
      "LE": "a < b + FP_LARGE_EPS",
      "Between": "GE(a,min) && LE(a,max)",
      "boundaryMeaning": "For positive FP_LARGE_EPS, Between includes both exact bounds; LT excludes exact max and a tolerance band below it. These are not literal >=, <, <= comparisons.",
      "epsilon": {
        "status": "Inferred numeric approximation",
        "metadataFloatLARGE_EPS": {
          "fieldIndex": 264579,
