  "handbookEvidence": {
    "enemy_9021_acduml": [
      {
        "text": "在场时持续召唤【暗色的喟叹】形态<“余音”>；生命值低于一定比例时，召唤间隔缩短",
        "textFormat": "NORMAL"
      },
      {
        "text": "优先攻击【暗色的喟叹】形态<“余音”>",
        "textFormat": "NORMAL"
      },
      {
        "text": "【裂管之奏】选择场上所有【暗色的喟叹】形态<“余音”>进行一次三连击，造成范围法术伤害和<$ba.dt.apoptosis>凋亡损伤</>",
        "textFormat": "NORMAL"
      },
      {
        "text": "隐秘核心",
        "textFormat": "TITLE"
      },
      {
        "text": "在模拟中达成特定条件并进入隐秘核心回合时，<假想敌：弦>将与<假想敌：管>同时登场",
        "textFormat": "NORMAL"
      }
    ],
    "enemy_9021_acduml_2": [
      {
        "text": "在场时持续召唤【暗色的喟叹】形态<“余音”>；生命值低于一定比例时，召唤间隔缩短",
        "textFormat": "NORMAL"
      },
      {
        "text": "优先攻击【暗色的喟叹】形态<“余音”>",
        "textFormat": "NORMAL"
      },
      {
        "text": "【裂管之奏】选择场上所有【暗色的喟叹】形态<“余音”>进行一次三连击，造成范围法术伤害和<$ba.dt.apoptosis>凋亡损伤</>",
        "textFormat": "NORMAL"
      },
      {
        "text": "隐秘核心",
        "textFormat": "TITLE"
      },
      {
        "text": "在模拟中达成特定条件并进入隐秘核心回合时，<假想敌：弦>将与<假想敌：管>同时登场",
        "textFormat": "NORMAL"
      }
    ],
    "enemy_9023_acdums": [
      {
        "text": "需要数次攻击击倒",
        "textFormat": "NORMAL"
      },
      {
        "text": "只能被阻挡数大于等于2的单位阻挡",
        "textFormat": "NORMAL"
      },
      {
        "text": "【复调】：在【金黄的悲号】与【暗色的喟叹】形态之间转换",
        "textFormat": "NORMAL"
      },
      {
        "text": "【金黄的悲号】形态时攻击速度提升，受到数次伤害后转换为【暗色的喟叹】形态",
        "textFormat": "NORMAL"
      },
      {
        "text": "【暗色的喟叹】形态时移动速度下降，攻击力提升，受到数次伤害后转换为【金黄的悲号】形态",
        "textFormat": "NORMAL"
      },
      {
        "text": "受到伤害时以自身为中心造成一次范围法术伤害和<$ba.dt.apoptosis>凋亡损伤</>",
        "textFormat": "NORMAL"
      },
      {
        "text": "全场所有<“余音”>周期性一同进行一次合奏造成范围法术伤害和<$ba.dt.apoptosis>凋亡损伤</>",
        "textFormat": "NORMAL"
      }
    ]
