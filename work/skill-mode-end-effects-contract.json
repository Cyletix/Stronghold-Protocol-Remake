  "nativeObservations": {
    "reset": "SetData clears offset 0x29",
    "arm": "OnEvent compares event 2 then sets offset 0x29",
    "poll": "OnTick onlyCheck offset 0x28 false + armed offset 0x29 true + ability not affecting; clears armed before AddBuff(owner,owner,ability.blackboard)",
    "stop": "OnStopAffect adds Buffs only if offset 0x28 true; all admitted source fields have false"
  },
  "lifecycleModel": {
    "arm": "accepted cast start",
    "emit": "first live attached transition to not-affecting",
    "completionReasons": [
      "expire",
      "live-manual-end",
      "live-interruption"
    ],
    "discardReasons": [
      "death",
      "retreat",
      "removed",
      "pre-cast-cancel"
    ],
    "frameOrdering": "restore active mode and detach skill layers before evaluating end-status resistance",
    "nativeReasonDispatchProven": false
  },
  "integration": {
    "compiler": "Call compile_end_effects before final all-level key equality; admit only its fully consumed companion type, then preserve all remaining parent graph checks.",
    "programField": "endEffects",
    "runtimeState": "A plain JSON per-cast armed state plus source-owned status records outside active clientProgramState.",
    "runtimeApi": {
      "validate": "validate(endEffects, blackboard)",
      "start": "start(unit,time) -> boolean; freeze durations into skillEndEffectState",
      "finish": "finish(unit,time,reason=\"end\") -> added count; after active skill/program cleanup",
      "stunned": "stunned(unit,time) -> boolean; sourceSkillEndStatuses only, no raw timer writes",
      "hasBuff": "hasBuff(unit,key,time) -> exact-key boolean",
      "clear": "clear(unit,{cancelPending:false}); dispel keeps pending armed effect, death/reset passes true"
    },
    "start": "Arm only after successful cast start; no effect during construction, rejected cast or pre-cast cancellation.",
    "finish": "Consume once for a live attached owner after restoring active skill layers; discard armed state on death/removal/retreat.",
    "consumers": [
      {
        "path": "web/engine.js",
        "entry": "operatorCanAct",
        "needed": "Read source-owned stun alongside legacy timers."
      },
      {
        "path": "web/src/simulation/operator-combat.js",
        "entry": "blockerAvailable",
        "needed": "Stunned owners cannot maintain an available blocker."
      },
      {
        "path": "web/engine.js",
        "entry": "abnormalHealingState / performHealingAction abnormal-clear branch",
        "needed": "Recognize owned stun for abnormal healing and clear its status record with the legacy timer; never leave a stale exact-key Buff after dispel."
      },
      {
        "path": "web/engine.js",
        "entry": "notifyGarrisonStatuses",
        "needed": "Feed owned stun into status transition notifications and clear the observed state at expiry or dispel."
      },
      {
        "path": "web/engine.js",
        "entry": "tryKill / respawnOperators",
        "needed": "Clear both per-cast armed state and owned end statuses; a later life cannot inherit either."
      },
      {
        "path": "web/src/simulation/operator-combat.js",
        "entry": "sourceBuffActive",
        "needed": "If status storage is separate, exact-key queries must include the new owned record."
      },
      {
        "path": "tools/lib/room-game-runtime.js",
        "entry": "capture / restore",
        "needed": "Plain IDs and times serialize through existing unit state; verify before-completion and after-status snapshots once."
      }
    ],
    "legacyProviderBoundary": "Ghost S2 is already explicit and is a migration-only same-shape member. Do not run its legacy expire stun and the new endEffects contract simultaneously."
  },
